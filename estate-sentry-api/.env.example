# Estate Sentry API Environment Configuration
#
# NOTE: For comprehensive configuration including all Docker services,
# use the root .env.example file instead: /../.env.example
#
# This file is for standalone API development without Docker.

# =============================================================================
# Django Settings
# =============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Database (SQLite for local development)
# =============================================================================
DATABASE_ENGINE=sqlite

# For PostgreSQL:
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=estate_sentry
# POSTGRES_USER=estate_sentry
# POSTGRES_PASSWORD=changeme
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# =============================================================================
# CORS Settings
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:8000

# =============================================================================
# Neo4j (optional for local development)
# =============================================================================
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=changeme

# =============================================================================
# See root .env.example for complete configuration
# =============================================================================
