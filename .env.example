# =============================================================================
# Estate Sentry Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment

# =============================================================================
# DJANGO API SETTINGS
# =============================================================================

# Secret key for Django (generate a new one for production)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-in-production-use-random-key

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,api

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8000

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================

# Database engine: sqlite or postgresql
DATABASE_ENGINE=postgresql

# PostgreSQL connection settings
POSTGRES_DB=estate_sentry
POSTGRES_USER=estate_sentry
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# NEO4J GRAPH DATABASE
# =============================================================================

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# =============================================================================
# NATS MESSAGE QUEUE (SWITCHBOARD)
# =============================================================================

NATS_URL=nats://localhost:4222
NATS_PORT=4222
NATS_HTTP_PORT=8222

# =============================================================================
# MINIO OBJECT STORAGE
# =============================================================================

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=estate-sentry
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# CHROMADB VECTOR DATABASE
# =============================================================================

CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# =============================================================================
# APPLICATION PORTS
# =============================================================================

API_PORT=8000

# =============================================================================
# SECURITY SETTINGS (PRODUCTION)
# =============================================================================

# Uncomment for production
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# =============================================================================
# EMAIL NOTIFICATIONS (OPTIONAL)
# =============================================================================

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password

# =============================================================================
# ERROR TRACKING (OPTIONAL)
# =============================================================================

# SENTRY_DSN=your-sentry-dsn

# =============================================================================
# REDIS CACHE (OPTIONAL)
# =============================================================================

# REDIS_URL=redis://localhost:6379/0
